{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "720px", "wideSize": "1100px" },
		"color": {
			"palette": [
				{ "slug": "background", "name": "Background", "color": "#ffffff" },
				{ "slug": "foreground", "name": "Foreground", "color": "#111111" },
				{ "slug": "primary", "name": "Primary", "color": "#0b5fff" },
				{ "slug": "secondary", "name": "Secondary", "color": "#1f2a44" },
				{ "slug": "accent", "name": "Accent", "color": "#f5a623" }
			]
		},
		"typography": {
			"fontFamilies": [
				{ "slug": "body", "name": "Body", "fontFamily": "system-ui, -apple-system, 'Segoe UI', sans-serif" },
				{ "slug": "heading", "name": "Heading", "fontFamily": "system-ui, -apple-system, 'Segoe UI', sans-serif" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--background)", "text": "var(--wp--preset--color--foreground)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)" },
		"elements": {
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)" } },
			"link": { "color": { "text": "var(--wp--preset--color--primary)" } }
		}
	}
}
